# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Google Maps API Key (for map display and place autocomplete)
# Required APIs: Maps JavaScript API, Places API
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URL (for production)
# In development, the Vite proxy handles this
VITE_API_URL=http://localhost:8000
